# Copy to .env for `npm run dev`:
#   cp .env.example .env
#
# The dev server always offers a loopback-only test sign-in. To try Google too, set an OAuth client
# whose redirect URIs include http://127.0.0.1:5173/api/auth/google/callback.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
