{
  "name": "peerly",
  "private": false,
  "version": "2.0.0",
  "description": "Encrypted team chat, files and calls that go peer to peer; a premium plan adds history, cloud files and relays",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XeonFX/Peerly.git"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "VITE_APP_ID=peerly tsc -b && VITE_APP_ID=peerly vite build && npm run guard:bundle",
    "build:preview": "VITE_APP_ID=peerly tsc -b && VITE_APP_ID=peerly vite build --outDir dist-preview && node scripts/guard-bundle.mjs dist-preview",
    "build:e2e": "VITE_APP_ID=peerly VITE_E2E_AUTH=true tsc -b && VITE_APP_ID=peerly VITE_E2E_AUTH=true vite build --outDir dist-e2e && VITE_E2E_AUTH=true node scripts/check-e2e-fixtures.mjs dist-e2e",
    "guard:bundle": "node scripts/guard-bundle.mjs dist",
    "typecheck": "VITE_APP_ID=peerly tsc -b",
    "lint": "oxlint",
    "test": "VITE_APP_ID=peerly vitest run --maxWorkers=4 && npm run test:scripts",
    "test:watch": "VITE_APP_ID=peerly vitest",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:coverage": "VITE_APP_ID=peerly vitest run --coverage --maxWorkers=4",
    "test:mutation": "VITE_APP_ID=peerly stryker run",
    "test:e2e": "VITE_APP_ID=peerly playwright test",
    "test:a11y": "VITE_APP_ID=peerly playwright test e2e/accessibility.spec.ts",
    "check:csp": "node scripts/check-csp.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "worker:check": "wrangler types --check && wrangler types worker-configuration.preview.d.ts -c wrangler.preview.jsonc --env-interface PreviewEnv --check && wrangler deploy --dry-run --env='' && wrangler deploy --dry-run -c wrangler.preview.jsonc",
    "deploy:preview": "wrangler deploy -c wrangler.preview.jsonc",
    "test:bump": "node --test scripts/bump-version.test.mjs",
    "legal:export": "node scripts/export-legal.mjs"
  },
  "dependencies": {
    "@codefusion-cc/app-update": "^1.1.0",
    "@codefusion-cc/console": "^0.11.1",
    "@codefusion-cc/google-sign-in": "^1.0.0",
    "@codefusion-cc/realtime": "^1.1.0",
    "@codefusion-cc/realtime-media": "^1.2.0",
    "@codefusion-cc/realtime-p2p": "^1.0.0",
    "@codefusion-cc/theme": "^1.0.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vitest-plugin": "^1.2.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "daisyui": "^5.6.18",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.1"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "qs": "^6.15.3"
  }
}
