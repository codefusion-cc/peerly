{
  "name": "@peerly/core",
  "version": "1.16.0",
  "private": true,
  "description": "Reusable encrypted realtime core with authenticated Durable Objects, P2P rooms, device identity, signing, media, and presence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codefusion-cc/peerly.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./worker/oidc": {
      "default": "./worker/oidc.mjs"
    },
    "./worker/rendezvous": {
      "default": "./worker/rendezvous.mjs"
    },
    "./worker/lobby-identity": {
      "default": "./worker/lobbyIdentity.mjs"
    },
    "./realtime/protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./realtime/domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./realtime/ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./worker/realtime/channel": {
      "default": "./worker/realtime/gateway/authorizedChannel.mjs"
    },
    "./worker/realtime/ephemeral-channel": {
      "default": "./worker/realtime/gateway/ephemeralChannel.mjs"
    },
    "./worker/identity": {
      "default": "./worker/identity.mjs"
    }
  },
  "files": [
    "dist",
    "worker",
    "scripts/check-vite-bundle.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@codefusion-cc/realtime-media": "^0.1.5",
    "@trystero-p2p/core": "^0.25.3",
    "@trystero-p2p/nostr": "^0.25.3"
  },
  "peerDependencies": {
    "@trystero-p2p/supabase": "^0.25.3",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@trystero-p2p/supabase": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "trystero",
    "durable-objects",
    "peerly",
    "room",
    "nostr"
  ]
}
