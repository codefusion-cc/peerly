{
  "name": "@peerly/core",
  "version": "1.16.0",
  "private": true,
  "description": "Reusable encrypted realtime core with authenticated Durable Objects, P2P rooms, device identity, signing, media, and presence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codefusion-cc/peerly.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@peerly/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@peerly/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./worker/oidc": {
      "default": "./worker/oidc.mjs"
    },
    "./worker/rendezvous": {
      "default": "./worker/rendezvous.mjs"
    },
    "./worker/lobby-identity": {
      "default": "./worker/lobbyIdentity.mjs"
    },
    "./realtime/protocol": {
      "@peerly/source": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./realtime/domain": {
      "@peerly/source": "./src/domain/index.ts",
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./realtime/ports": {
      "@peerly/source": "./src/ports/index.ts",
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./worker/realtime/channel": {
      "default": "./worker/realtime/gateway/authorizedChannel.mjs"
    },
    "./worker/realtime/ephemeral-channel": {
      "default": "./worker/realtime/gateway/ephemeralChannel.mjs"
    },
    "./worker/realtime/signal-scope": {
      "default": "./worker/realtime/gateway/signalScope.mjs"
    },
    "./worker/identity": {
      "default": "./worker/identity.mjs"
    },
    "./device-token": {
      "@peerly/source": "./src/auth/deviceToken.ts",
      "types": "./dist/auth/deviceToken.d.ts",
      "default": "./dist/auth/deviceToken.js"
    },
    "./user-id": {
      "@peerly/source": "./src/userId.ts",
      "types": "./dist/userId.d.ts",
      "default": "./dist/userId.js"
    },
    "./usage-budget": {
      "@peerly/source": "./src/usageBudget.ts",
      "types": "./dist/usageBudget.d.ts",
      "default": "./dist/usageBudget.js"
    },
    "./channel-capability": {
      "@peerly/source": "./src/channelCapability.ts",
      "types": "./dist/channelCapability.d.ts",
      "default": "./dist/channelCapability.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "peerly-check-vite-bundle": "./scripts/check-vite-bundle.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --maxWorkers=4 && node scripts/check-self-contained.mjs",
    "test:coverage": "vitest run --coverage --maxWorkers=4"
  },
  "dependencies": {
    "@codefusion-cc/google-sign-in": "0.1.3",
    "@codefusion-cc/realtime": "0.1.6",
    "@codefusion-cc/realtime-media": "0.1.7",
    "@trystero-p2p/core": "0.25.3",
    "@trystero-p2p/nostr": "0.25.3"
  },
  "peerDependencies": {
    "@trystero-p2p/supabase": "^0.25.3",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@trystero-p2p/supabase": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@trystero-p2p/supabase": "0.25.3",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
