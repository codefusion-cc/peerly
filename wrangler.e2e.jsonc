{
  // The browser E2E target: the same worker, the same Durable Objects and the
  // same routes as a deployment, running on localhost. Started by
  // server/test-server.mjs, which sets the content backend, the assets
  // directory and the harness's own origin per suite:
  //
  //   npm run test:e2e      production's shape (content peer to peer)
  //   npm run test:e2e:do   preview's shape (content in the Durable Objects)
  //
  // Never deployed. It has no routes, and it configures a test identity
  // provider whose JWKS is served from its own origin — which is safe only
  // because that origin is a loopback address that exists for one test run.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peerly-e2e",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-22",
  "vars": {
    "APP_ID": "peerly",
    "CONTENT_BACKEND": "p2p",

    // The harness's own origin, matched as one exact string. Production sets
    // nothing here and so allows nothing extra — see worker/index.mjs.
    "E2E_ALLOWED_ORIGIN": "http://127.0.0.1:17273",

    // The generic OIDC provider, configured only here. A deployment that sets
    // none of these resolves the provider to `null` and the route 503s, so
    // test-only auth stays configuration rather than a code branch.
    "VITE_OIDC_CLIENT_ID": "peerly-e2e-client",
    "VITE_OIDC_ISSUER": "https://e2e.peerly.test",
    "OIDC_JWKS_URL": "http://127.0.0.1:17273/.well-known/jwks.json"

    // No TURN key: two Chromium contexts on one host connect over host
    // candidates and never exercise a relay, so offering one here would only
    // make the test look like it covered something it cannot. Calls then use
    // Cloudflare's STUN alone, as a deployment without a TURN key does.
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist-e2e",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "RENDEZVOUS_RATE_LIMITER",
      "namespace_id": "1099",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Caps /api/network/enroll and /api/network/session. These are the only
      // way to make the control plane spend Durable Object requests without
      // already holding a socket, and nothing capped them until a runaway
      // client spent a whole daily quota through them.
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1098",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Applied alongside AUTH_RATE_LIMITER, both must allow. A device key is
      // a keypair the client generates, so limiting on it alone hands a fresh
      // allowance to anyone willing to rotate; the address is what a rotating
      // client cannot shed.
      "name": "AUTH_IP_RATE_LIMITER",
      "namespace_id": "1097",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_GATEWAYS", "class_name": "UserGatewayDO" },
      { "name": "SIGNAL_SCOPES", "class_name": "SignalScopeDO" },
      { "name": "CONTENT_CHANNELS", "class_name": "ContentChannelDO" },
      { "name": "LOBBY_CHANNELS", "class_name": "LobbyChannelDO" }
    ]
  },
  // No applied history to respect — this namespace is created fresh on every
  // run — so it carries the migration production will get rather than
  // preview's create-then-delete. That makes the harness a faithful stand-in
  // for the deployment that matters.
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": ["UserGatewayDO", "SignalScopeDO", "ContentChannelDO", "LobbyChannelDO"]
    }
  ]
}
