{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peerly-e2e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ID": "peerly",
    "APP_ENV": "test",
    // The e2e server writes its own origin over these (scripts/e2e-server.mjs).
    "E2E_ALLOWED_ORIGIN": "http://127.0.0.1:17273",
    "OIDC_CLIENT_ID": "peerly-e2e-client",
    "OIDC_ISSUER": "http://127.0.0.1:17273",
    "OIDC_JWKS_URL": "http://127.0.0.1:17273/.well-known/jwks.json",
    "OIDC_LABEL": "E2E"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist-e2e",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1098", "simple": { "limit": 1000, "period": 60 } },
    { "name": "AUTH_IP_RATE_LIMITER", "namespace_id": "1097", "simple": { "limit": 1000, "period": 60 } },
    { "name": "MEDIA_RATE_LIMITER", "namespace_id": "1096", "simple": { "limit": 100, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_GATEWAYS", "class_name": "UserGateway" },
      { "name": "CHANNELS", "class_name": "Channel" },
      { "name": "ACCOUNT_DIRECTORY", "class_name": "AccountDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v2-1", "new_sqlite_classes": ["UserGateway", "Channel", "AccountDirectory"] }
  ]
}
