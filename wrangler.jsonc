{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peerly",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "APP_ID": "peerly",
    "APP_ENV": "production",
    // Sign-in providers: set the ones this deployment offers (README, "Identity providers").
    "GOOGLE_CLIENT_ID": "724645084534-eb9led5upjj8p46dr890tg3a0k3sonsk.apps.googleusercontent.com"
  },
  // NETWORK_SESSION_SECRET signs capabilities and cookies (`current:previous` while it rotates);
  // OPAQUE_USER_ID_SECRET derives account and member ids and workspace routes, and never changes.
  // TURN_KEY_ID and TURN_KEY_API_TOKEN are a Cloudflare Realtime TURN key: premium accounts' relays.
  "secrets": {
    "required": ["NETWORK_SESSION_SECRET", "OPAQUE_USER_ID_SECRET", "TURN_KEY_ID", "TURN_KEY_API_TOKEN"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_IP_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 60, "period": 60 } },
    { "name": "MEDIA_RATE_LIMITER", "namespace_id": "1007", "simple": { "limit": 6, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_GATEWAYS", "class_name": "UserGateway" },
      { "name": "CHANNELS", "class_name": "Channel" }
    ]
  },
  // Production had no Durable Objects before 2.0: these apply with the first full deploy (merge to main).
  "migrations": [
    { "tag": "v2-1", "new_sqlite_classes": ["UserGateway", "Channel"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
