{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peerly-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "build": {
    "command": "npm run build:preview"
  },
  "routes": [
    { "pattern": "preview.peerly.cc", "custom_domain": true }
  ],
  "vars": {
    "APP_ID": "peerly",
    "APP_ENV": "preview",
    "GOOGLE_CLIENT_ID": "724645084534-eb9led5upjj8p46dr890tg3a0k3sonsk.apps.googleusercontent.com",
    // Branch previews (`<branch>.preview.peerly.cc`) sign in through this deployment.
    "AUTH_PREVIEW_PARENTS": "preview.peerly.cc"
  },
  "secrets": {
    "required": ["NETWORK_SESSION_SECRET", "OPAQUE_USER_ID_SECRET", "TURN_KEY_ID", "TURN_KEY_API_TOKEN"]
  },
  // CodeFusion Console reads every invocation (Failures, Health, Logs) and files this Worker as staging.
  // It keeps no IPs, headers, query strings or bodies.
  "tail_consumers": [{ "service": "codefusion-console" }],
  // Errors from Peerly's pages, for the console's Failures (createConsoleRoutes, worker/index.ts).
  "services": [
    { "binding": "CONSOLE_TELEMETRY", "service": "codefusion-console", "entrypoint": "AppTelemetry" }
  ],
  // Anonymous page view counts for the console's Visits page: no visitor id, IP or user agent.
  "analytics_engine_datasets": [
    { "binding": "VISITS", "dataset": "cfc_visits" }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist-preview",
    "not_found_handling": "single-page-application",
    // With privateSourceMaps(): the Worker answers /_console/*, so the source maps stay private.
    "run_worker_first": ["/api/*", "/_console/*"]
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_IP_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    // Error reports from pages, per connection.
    { "name": "BROWSER_FAILURE_RATE_LIMITER", "namespace_id": "1010", "simple": { "limit": 10, "period": 60 } },
    // Cloud file uploads, per account.
    { "name": "FILES_RATE_LIMITER", "namespace_id": "1012", "simple": { "limit": 30, "period": 60 } },
    { "name": "MEDIA_RATE_LIMITER", "namespace_id": "1008", "simple": { "limit": 6, "period": 60 } }
  ],
  // Premium workspaces' files, sealed on the page; a channel deletes them when its history ends.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "peerly-files-preview" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_GATEWAYS", "class_name": "UserGateway" },
      { "name": "CHANNELS", "class_name": "Channel" },
      // Accounts and their plans, for staff in CodeFusion Console (membershipGateway keeps it).
      { "name": "ACCOUNT_DIRECTORY", "class_name": "AccountDirectory" }
    ]
  },
  "migrations": [
    { "tag": "realtime-v1", "new_sqlite_classes": ["UserGatewayDO", "SignalScopeDO", "WorkspaceDO"] },
    { "tag": "realtime-v2", "deleted_classes": ["WorkspaceDO"] },
    { "tag": "realtime-v3", "new_sqlite_classes": ["ContentChannelDO", "LobbyChannelDO"] },
    // 2.0 runs on @codefusion-cc/realtime: the preview's old objects (and what they held) go.
    {
      "tag": "v2-1",
      "new_sqlite_classes": ["UserGateway", "Channel", "AccountDirectory"],
      "deleted_classes": ["UserGatewayDO", "SignalScopeDO", "ContentChannelDO", "LobbyChannelDO"]
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
